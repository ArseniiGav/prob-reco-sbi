# HTCondor submit file: one shard of the data set per job, generated by run_shard.sh.
#
# ADAPT TO YOUR CLUSTER before use: accounting group, requirements, file transfer, the number of jobs and the settings
# of run_shard.sh (passed in "environment"). Submit from the repository root:
#
#     mkdir -p logs
#     condor_submit examples/cluster/htcondor.sub
#     condor_q                                      # follow the jobs

# every job runs run_shard.sh with its process number 0, 1, 2, ... as the shard index
executable = examples/cluster/run_shard.sh
arguments  = $(ProcId)

# This example assumes a shared file system: the jobs use the virtual environment and write the shards in place.
# Without one, ask your cluster's documentation how to transfer the environment and the output files.
should_transfer_files = NO

# settings of run_shard.sh; THREADS should equal request_cpus
environment = "THREADS=4 EVENTS=100000 BASE_SEED=1000 PRESET=full OUT_DIR=data/shards"

request_cpus   = 4
request_memory = 2GB
request_disk   = 1GB
# request_gpus = 1                  # a GPU node; then add DEVICE=cuda to environment

# accounting_group = my_group       # ADAPT: some clusters require one

# job log, standard output and standard error of every job (the logs folder must exist before submitting)
log    = logs/flashsim_$(ClusterId)_$(ProcId).log
output = logs/flashsim_$(ClusterId)_$(ProcId).out
error  = logs/flashsim_$(ClusterId)_$(ProcId).err

# run a failed job again (shards that are complete are skipped by run_shard.sh)
max_retries = 2
# for hundreds of jobs: keep at most this many idle jobs in the queue at a time
# materialize_max_idle = 50

# 10 jobs, shard indices 0 to 9
queue 10
